{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // DOM is included so the test suite can typecheck and exercise
    // src/api/browserPrivateStateProvider.ts, which is browser code (localStorage)
    // but is unit-tested here against a localStorage stub.
    "lib": ["ES2022", "DOM"],
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/network.ts",
    "src/wallet.ts",
    "src/deploy.ts",
    "src/api/privateState.ts",
    "src/api/browserPrivateStateProvider.ts",
    "src/api/isPastDeadline.ts",
    "tests",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "managed"]
}
